# LOCAL dev only — copy to .env.local (inside web/) and fill in your
# Firebase project's web config (Firebase console -> Project settings).
# This is NOT the Gemini key — that lives only in Secret Manager and is
# injected into the Cloud Run server as an env var, never read by the
# frontend at all.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=true
VITE_ENABLE_APP_CHECK=false
# Production only: score-based reCAPTCHA Enterprise site key registered in
# Firebase App Check. Do not use the production key for localhost.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Points the frontend at your local Express server during dev (see
# server/src/index.ts's local-dev port fallback). Leave empty in
# production — frontend and API are served same-origin from Cloud Run.
VITE_API_BASE_URL=http://localhost:8081
